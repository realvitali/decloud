# ═══════════════════════════════════════════════════════════════
# DeCloud — Configuration
# Copy this file to ".env" and fill in your values.
# All paths can also be set via environment variables directly.
# ═══════════════════════════════════════════════════════════════

# ─── Core ───────────────────────────────────────────────────────
# Port to run DeCloud on
DECLOUD_PORT=8899
# Bind address (127.0.0.1 = localhost only, safest default.
# Change to 0.0.0.0 ONLY if using Tailscale and you need LAN access)
DECLOUD_HOST=127.0.0.1

# SSL certs (optional — for HTTPS)
# Generate with: tailscale cert <machine>.<tailnet>.ts.net
# Then set these to the cert/key file paths, or just drop *.crt + *.key
# files in the app directory and they'll be auto-detected.
# DECLOUD_SSL_CERT=/path/to/cert.crt
# DECLOUD_SSL_KEY=/path/to/cert.key

# ─── Content directories ────────────────────────────────────────
# Where your books live (PDF, JSON, TXT)
DECLOUD_BOOKS_DIR=~/Books

# The directory the Files app browses (defaults to your home directory)
DECLOUD_FILES_DIR=~

# Music directory
DECLOUD_MUSIC_DIR=~/Music

# ─── AI integrations (optional) ────────────────────────────────
# Ollama endpoint for local LLM chat
OLLAMA_HOST=http://localhost:11434
# Default model for LLM features (book summaries, etc)
DECLOUD_LLM_MODEL=llama3.2

# ComfyUI for AI image generation
COMFY_URL=http://localhost:8188
DECLOUD_COMFY_OUTPUT=~/ComfyUI/output
DECLOUD_COMFY_INPUT=~/ComfyUI/input

# ─── Voice / TTS (optional) ────────────────────────────────────
# Piper TTS voice models directory
DECLOUD_PIPER_DIR=~/.local/share/piper

# ─── Optional features (uncomment to enable) ───────────────────

# OSINT privacy scanner — needs osint-tools installed separately
# DECLOUD_OSINT_DIR=/path/to/osint-tools

# Journal / People graph — needs an Obsidian vault or markdown dir
# DECLOUD_JOURNAL_DIR=~/Documents/MyVault

# Hermes Agent integration — for the Agents panel
# DECLOUD_HERMES_HOME=~/.config/home-agent

# Flask
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-me-to-a-random-string

# ─── Security ───────────────────────────────────────────────────
# Passcode required to access the app. Generated automatically by
# install.sh (8 digits). Longer passphrases (up to 64 chars) work too;
# the app warns if it's shorter than 8 characters. If empty, the app
# runs in OPEN MODE (no auth) — only for local development.
# DECLOUD_PIN=

# ─── Music Generator (local MiniMax Music 3 via ComfyUI) ──────────
# Where generated songs are stored (and the history index)
# DECLOUD_MUSICGEN_DIR=~/Music/decloud-generated
# Path to your exported ComfyUI workflow in API format. Export from
# ComfyUI: enable dev mode → "Save (API format)", then copy the JSON
# here or into the app directory as musicgen_workflow.json
# DECLOUD_MUSICGEN_WORKFLOW=~/decloud/musicgen_workflow.json

# ─── AI Model Advisor (download models right from DeCloud) ────────
# Where downloaded models live. Chat GGUFs go here (chat/ subfolder)
# and can be auto-imported into Ollama. Image/video/music models go
# into your ComfyUI models tree.
# DECLOUD_MODELS_DIR=~/Models
# ComfyUI models root (auto-derived from COMFYUI output usually):
# DECLOUD_COMFY_MODELS_DIR=~/ComfyUI/models

# ─── ComfyUI lifecycle ────────────────────────────────────────────
# If ComfyUI isn't a systemd user service and isn't at ~/ComfyUI,
# tell DeCloud the exact command that starts it (used by the
# Start ComfyUI button in the UI):
# DECLOUD_COMFY_CMD=/home/you/ComfyUI/venv/bin/python /home/you/ComfyUI/main.py --listen
