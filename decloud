#!/bin/bash
# DeCloud wrapper — starts app + tunnel together, manages lifecycle
# Usage: ./decloud start|stop|restart|qr|status

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$APP_DIR"

PORT=${DECLOUD_PORT:-8899}
TUNNEL_LOG="$APP_DIR/tunnel.log"
TUNNEL_URL_FILE="$APP_DIR/tunnel.url"
TUNNEL_PID_FILE="$APP_DIR/tunnel.pid"
APP_PID_FILE="$APP_DIR/app.pid"

# ─── Version ──────────────────────────────────────────────────────
VERSION="0.6.1"

# ─── Helpers ────────────────────────────────────────────────────

get_serve_state() {
    # Inspect the actual configuration; a cached URL or a live PID does not
    # prove that the proxy is private or even points to this app.
    tailscale serve status --json 2>/dev/null | python3 -c '
import json, sys
from urllib.parse import urlsplit
try:
    cfg = json.load(sys.stdin)
    port = int(sys.argv[1])
    for host, web in (cfg.get("Web") or {}).items():
        if not host.endswith(":443"):
            continue
        target = urlsplit((web.get("Handlers") or {}).get("/", {}).get("Proxy", ""))
        if target.hostname not in ("localhost", "127.0.0.1", "::1") or target.port != port:
            print("occupied")
            break
        public = (cfg.get("AllowFunnel") or {}).get(host, False)
        print(("public " if public else "private ") + "https://" + host[:-4])
        break
    else:
        print("none")
except (ValueError, TypeError, AttributeError):
    print("unknown")
' "$PORT"
}

get_tunnel_url() {
    local state
    state=$(get_serve_state)
    case "$state" in private\ *) echo "${state#private }" ;; *) return 1 ;; esac
}

start_app() {
    if [ -f "$APP_PID_FILE" ] && kill -0 $(cat "$APP_PID_FILE") 2>/dev/null; then
        echo "App already running (PID: $(cat $APP_PID_FILE))"
        return 0
    fi
    # Already served by systemd/launchd/WSL nohup? Don't start a second copy
    # (it would crash-loop on the busy port forever).
    if curl -s http://localhost:$PORT/ > /dev/null 2>&1; then
        echo "✓ App already running at http://localhost:$PORT"
        return 0
    fi
    echo "Starting DeCloud app on port $PORT..."
    # Supervise the app: if it exits (crash or a self-update restart), bring
    # it right back on the new code — one-click updates work even when
    # systemd/launchd/scheduled-task aren't the thing managing it.
    umask 077   # app.log / tunnel.log hold request paths and tailnet IPs: owner only
    setsid env DECLOUD_DIR="$APP_DIR" nohup sh -c '
        cd "$DECLOUD_DIR" || exit 1
        . ./.venv/bin/activate 2>/dev/null || true
        while true; do
            python app.py
            sleep 2
        done
    ' > app.log 2>&1 < /dev/null &
    echo $! > "$APP_PID_FILE"
    disown
    sleep 2
    if curl -s http://localhost:$PORT/ > /dev/null 2>&1; then
        echo "✓ App running at http://localhost:$PORT"
    else
        echo "✗ App failed to start — check app.log"
        return 1
    fi
}

stop_app() {
    if [ -f "$APP_PID_FILE" ]; then
        PID=$(cat "$APP_PID_FILE")
        # Kill the whole supervisor process group (shell loop + the app).
        kill -TERM -- -"$PID" 2>/dev/null || kill -TERM "$PID" 2>/dev/null || true
        rm -f "$APP_PID_FILE"
        echo "App stopped"
    fi
}

start_tunnel() {
    # Open mode has no passcode: never share it with the tailnet
    if [ "${DECLOUD_INSECURE_OPEN:-}" = "1" ] || grep -qE '^[[:space:]]*DECLOUD_INSECURE_OPEN[[:space:]]*=[[:space:]]*"?1"?[[:space:]]*$' "$APP_DIR/.env" 2>/dev/null; then
        echo "⚠ Open mode (DECLOUD_INSECURE_OPEN=1) is on, so DeCloud stays local. Set DECLOUD_PIN to share it."
        return 1
    fi
    echo "Starting private Tailscale Serve..."
    # Check if tailscale is available
    if ! command -v tailscale &>/dev/null; then
        echo "⚠ Tailscale not installed — skipping tunnel."
        echo "  Install it: curl -fsSL https://tailscale.com/install.sh | sh"
        echo "  Then run:   sudo tailscale up  (login to your account)"
        echo "  Then:       ./decloud start"
        return 1
    fi

    # Check if tailscale is running
    if ! tailscale status &>/dev/null; then
        echo "⚠ Tailscale not running — skipping tunnel."
        echo "  Run: sudo tailscale up  (login to your account)"
        echo "  Then: ./decloud start"
        return 1
    fi

    local state url
    state=$(get_serve_state)
    case "$state" in
        private\ *) echo "✓ Private Serve active: ${state#private }"; return 0 ;;
        public\ *)
            # Remove the existing public DeCloud route before replacing it.
            tailscale funnel --https=443 off > "$TUNNEL_LOG" 2>&1 || { echo "Could not turn off Funnel; check tunnel.log"; return 1; } ;;
        occupied) echo "Tailscale HTTPS port 443 is used by another service; not changing it."; return 1 ;;
        unknown) echo "Could not inspect Tailscale Serve configuration."; return 1 ;;
    esac
    if ! tailscale serve --bg --https=443 "http://127.0.0.1:$PORT" > "$TUNNEL_LOG" 2>&1; then
        echo "⚠ Serve failed — check tunnel.log"
        return 1
    fi
    url=$(get_tunnel_url) || { echo "⚠ Could not confirm private Serve; check Tailscale status."; return 1; }
    echo "$url" > "$TUNNEL_URL_FILE"
    echo "✓ Private Serve active: $url"
}

stop_tunnel() {
    # Only remove the matching DeCloud route, leaving other Tailscale services alone.
    if command -v tailscale &>/dev/null; then
        case "$(get_serve_state)" in
            private\ *|public\ *) tailscale serve --https=443 off 2>/dev/null || true ;;
        esac
    fi

    if [ -f "$TUNNEL_PID_FILE" ]; then
        kill $(cat "$TUNNEL_PID_FILE") 2>/dev/null || true
        rm -f "$TUNNEL_PID_FILE"
    fi
    rm -f "$TUNNEL_URL_FILE"  # Clear cached URL
}

show_qr() {
    URL=$(get_tunnel_url)
    if [ -z "$URL" ]; then
        echo "No tunnel URL found."
        echo ""
        echo "Debug info:"
        echo "  TUNNEL_LOG: $TUNNEL_LOG"
        echo "  Log exists: $(test -f "$TUNNEL_LOG" && echo yes || echo no)"
        echo "  Tunnel PID file: $(test -f "$TUNNEL_PID_FILE" && echo yes || echo no)"
        if [ -f "$TUNNEL_LOG" ]; then
            echo ""
            echo "Last 5 lines of tunnel.log:"
            tail -5 "$TUNNEL_LOG" | cat -v
        fi
        echo ""
        echo "Try: ./decloud restart"
        return 1
    fi
    
    PASSCODE=$(grep '^DECLOUD_PIN=' .env 2>/dev/null | tail -1 | cut -d= -f2- || echo "not set")

    echo ""
    echo "DeCloud Tunnel"
    echo "════════════════════════════════════════"
    echo "URL: $URL"
    echo "Passcode: $PASSCODE"
    echo ""

    if command -v qrencode &>/dev/null; then
        qrencode -t ANSIUTF8 "$URL" 2>/dev/null || qrencode -t ANSI "$URL" 2>/dev/null
        echo ""
    else
        echo "(Install qrencode for QR code: sudo apt install qrencode)"
    fi

    echo ""
    echo "Private access: connect your phone to the same Tailscale tailnet."
    echo "The passcode unlocks a shell on this machine. Don't share it."
    echo ""
}

status() {
    echo "DeCloud Status"
    echo "══════════════"
    
    # App status
    if [ -f "$APP_PID_FILE" ] && kill -0 $(cat "$APP_PID_FILE") 2>/dev/null; then
        echo "App:     ✓ running (PID: $(cat $APP_PID_FILE))"
    elif curl -s "http://localhost:$PORT/" > /dev/null 2>&1; then
        echo "App:     ✓ responding on port $PORT"
    else
        echo "App:     ✗ not running"
    fi
    
    # Tunnel status
    if URL=$(get_tunnel_url); then
        echo "Tunnel:  ✓ private Serve active"
        echo "URL:     ${URL:-pending}"
    else
        echo "Tunnel:  ✗ not running"
    fi
    
    # Port check
    if curl -s http://localhost:$PORT/ > /dev/null 2>&1; then
        echo "Local:   ✓ http://localhost:$PORT"
    else
        echo "Local:   ✗ port $PORT not responding"
    fi
}

# ─── Main ───────────────────────────────────────────────────────

case "${1:-}" in
    -v|--version|version)
        echo "DeCloud $VERSION"
        ;;
    start)
        start_app && start_tunnel || exit $?
        echo "Forgot your passcode? Run: ./decloud pin"
        ;;
    stop)
        stop_app
        stop_tunnel
        echo "All stopped"
        ;;
    restart)
        # Installed as a service? Let the service manager restart it.
        if systemctl --user is-active --quiet decloud 2>/dev/null; then
            systemctl --user restart decloud && start_tunnel
            exit $?
        elif [ "$(uname)" = "Darwin" ] && launchctl list com.decloud.app &>/dev/null; then
            launchctl kickstart -k "gui/$(id -u)/com.decloud.app" && start_tunnel
            exit $?
        fi
        stop_app
        stop_tunnel
        sleep 1
        start_app && start_tunnel
        ;;
    qr|url)
        show_qr
        ;;
    status)
        status
        ;;
    update|upgrade)
        shift
        exec "$APP_DIR/.venv/bin/python" "$APP_DIR/scripts/decloud_update.py" "$@"
        ;;
    pin|passcode)
        shift
        exec "$APP_DIR/.venv/bin/python" "$APP_DIR/scripts/decloud_pin.py" "$@"
        ;;
    tui|dashboard)
        exec "$APP_DIR/.venv/bin/python" "$APP_DIR/scripts/decloud_tui.py"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|qr|status|pin|version|update|tui}"
        echo ""
        echo "  start   — Start app + tunnel"
        echo "  stop    — Stop everything"
        echo "  restart — Restart app + tunnel"
        echo "  qr      — Show current tunnel URL + QR code"
        echo "  status  — Show what's running"
        echo "  pin     — Show your passcode  (pin reset — get a new one, even if you forgot it)"
        echo "  version — Show DeCloud version"
        echo "  update  — Check/apply updates from the terminal"
        echo "            (update check | update | update rollback | update <version>)"
        echo "  tui     — Open the terminal dashboard"
        exit 1
        ;;
esac
